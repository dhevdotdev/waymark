{
  "name": "waymark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "size": "vite build --logLevel error && node scripts/check-bundle.mjs",
    "tauri": "tauri",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:sweep": "node tests/e2e/sweep.mjs",
    "test:visual": "node tests/e2e/visual.mjs",
    "install:app": "node scripts/install-app.mjs",
    "test:native": "tauri build --bundles app --features selftest && node tests/native/run.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "knip": "knip",
    "arch": "node scripts/check-architecture.mjs && node scripts/check-docs.mjs",
    "rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "pnpm lint && pnpm typecheck && pnpm arch && pnpm knip && pnpm dup && pnpm coverage && pnpm rust",
    "prepare": "lefthook install || true",
    "bootstrap": "pnpm install && playwright install webkit",
    "health": "node scripts/doctor.mjs",
    "coverage": "vitest run --coverage",
    "dup": "jscpd src src-tauri/src --min-lines 12 --threshold 3 --reporters console --silent"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@lezer/common": "^1.5.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "d3-force": "^3.0.1",
    "dompurify": "^3.4.17",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.3.0",
    "minisearch": "^7.2.0",
    "shiki": "^4.6.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "jscpd": "^5.4.2",
    "jsdom": "^31.0.0",
    "knip": "^6.44.2",
    "lefthook": "^2.2.2",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  }
}
